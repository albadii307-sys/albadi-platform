# ── Supabase (اتركها فارغة للتشغيل المحلي بوضع المعاينة) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── الموقع ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── لوحة التحكم (وضع المعاينة فقط) ──
ADMIN_EMAIL=admin@albadigroup.com
ADMIN_PASSWORD=
AUTH_SECRET=change-this-to-a-long-random-string

# ── البريد (Resend) ──
RESEND_API_KEY=
REQUESTS_NOTIFY_EMAIL=albadi@albadigroup.com
EMAIL_FROM="Al-Badi Website <noreply@albadigroup.com>"

# ── حماية الفورم (Cloudflare Turnstile) ──
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
